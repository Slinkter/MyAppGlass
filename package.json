{
    "name": "my-glass-app",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev -H 0.0.0.0 -p 3000",
        "build": "next build --webpack",
        "start": "next start",
        "lint": "eslint src/",
        "typecheck": "tsc --noEmit -p tsconfig.build.json",
        "test": "vitest",
        "test:run": "vitest run",
        "optimize": "node scripts/optimize-images.mjs",
        "generate:3d": "python scripts/generate-3d-from-image.py",
        "clean": "pnpm dlx rimraf node_modules .next dist out functions/node_modules",
        "deploy:hosting": "pnpm run build && npx firebase-tools deploy --only hosting",
        "deploy:functions": "firebase deploy --only functions"
    },
    "dependencies": {
        "@chakra-ui/react": "^3.35.0",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@google/model-viewer": "^4.3.1",
        "@react-google-maps/api": "^2.20.8",
        "@types/three": "^0.185.4",
        "firebase": "^12.12.1",
        "framer-motion": "^12.40.0",
        "lucide-react": "^1.11.0",
        "next": "^16.3.2",
        "next-themes": "^0.4.6",
        "pino": "^10.3.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "three": "^0.185.1",
        "xlsx": "^0.18.5",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@next/bundle-analyzer": "^16.3.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@types/react": "^18.3.28",
        "@types/react-dom": "^18.3.7",
        "@vitejs/plugin-react": "^6.0.5",
        "eslint": "^9.39.5",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.26",
        "globals": "^16.5.0",
        "jsdom": "^30.0.1",
        "pino-pretty": "^13.1.3",
        "sharp": "^0.34.5",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.65.0",
        "vitest": "^4.1.10"
    }
}
