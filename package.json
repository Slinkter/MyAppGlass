{
    "name": "myappglass",
    "version": "1.0.0",
    "private": true,
    "packageManager": "pnpm@12.16.1",
    "type": "module",
    "scripts": {
        "dev": "pnpm --filter @gya/web dev",
        "build": "pnpm --filter @gya/web build",
        "start": "pnpm dlx serve apps/web/out",
        "lint": "pnpm --filter @gya/web lint",
        "typecheck": "pnpm -r --if-present typecheck",
        "test": "pnpm --filter @gya/web test",
        "test:run": "pnpm --filter @gya/web test:run",
        "test:functions": "pnpm --filter @gya/functions test",
        "clean": "pnpm -r --if-present clean && pnpm dlx rimraf node_modules apps/functions/node_modules packages/shared/node_modules",
        "deploy:hosting": "pnpm run build && npx firebase-tools deploy --only hosting",
        "deploy:functions": "firebase deploy --only functions"
    },
    "devDependencies": {
        "typescript": "^5.8.2"
    }
}