        "firebase": "^12.12.1",
        "framer-motion": "^12.40.0",
        "lucide-react": "^1.11.0",
        "next": "^16.2.4",
        "next-themes": "^0.4.6",
        "pino": "^10.3.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@types/react": "^18.3.28",
        "@types/react-dom": "^18.3.7",
        "eslint": "^8.57.1",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^4.6.2",
        "eslint-plugin-react-refresh": "^0.4.26",
        "globals": "^16.5.0",
        "pino-pretty": "^13.1.3",
