rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Funciones auxiliares
    // ---------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    // Administrador = (a) claim role=admin, o (b) users/{uid}.role == 'admin' (evaluado al final
    // por cortocircuito para ahorrar lecturas). Decisión del dueño (2026-11-11): ya no basta
    // un correo @gyacompany.com; el rol se asigna a mano en Firestore.
    // Se eliminó el criterio "el correo contiene admin" (cualquiera podía
    // registrarse con ese correo y obtener privilegios).
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('role', '') == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ---------------------------------------------------------------
    // users/{uid}: documento de rol. Lo escribe AuthContext.tsx al registrarse
    // (uid, email, role, createdAt) y en el primer login (+ updatedAt).
    // ---------------------------------------------------------------
    // F2.1: 'role' nunca lo escribe el cliente salvo un admin: la creación propia
    // exige role == 'cliente' y la actualización propia no puede tocar 'role' ni 'uid'.
    match /users/{userId} {
      // Solo el dueño o un admin pueden leer (antes: cualquier autenticado).
      allow read: if isOwner(userId) || isAdmin();

      // El dueño solo puede crearse como 'cliente' y con campos esperados:
      // evita la autoescalada a admin.
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['uid', 'email', 'role', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['uid', 'email', 'role'])
        && request.resource.data.uid == userId
        && request.resource.data.role == 'cliente'
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254;

      // El dueño no puede cambiar 'role' ni 'uid'; solo email/updatedAt.
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'updatedAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254;

      // Admin: control total (asignar/revocar roles). Solo admin borra.
      allow create, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // clientes/{id}: datos personales (DNI/RUC, teléfono, dirección).
    // Registro propio: id == uid. El panel admin crea clientes con id automático.
    // ---------------------------------------------------------------
    match /clientes/{clientId} {
      // Antes: cualquier autenticado leía todos los perfiles. Ahora dueño o admin.
      allow read: if isOwner(clientId) || isAdmin();

      allow create: if isOwner(clientId)
        && request.resource.data.keys().hasOnly(
             ['userId', 'email', 'role', 'fullName', 'dniRuc', 'phone', 'address', 'district', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(
             ['userId', 'email', 'role', 'fullName', 'dniRuc', 'phone', 'address', 'district'])
        && request.resource.data.userId == clientId
        && request.resource.data.role == 'cliente'
        && request.resource.data.email is string && request.resource.data.email.size() <= 254
        && request.resource.data.fullName is string && request.resource.data.fullName.size() <= 200
        && request.resource.data.dniRuc is string && request.resource.data.dniRuc.matches('^([0-9]{8}|[0-9]{11})$')
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30
        && request.resource.data.address is string && request.resource.data.address.size() <= 300
        && request.resource.data.district is string && request.resource.data.district.size() <= 100;

      // El dueño edita sus datos de contacto, nunca role/userId/email.
      allow update: if isOwner(clientId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'phone', 'address', 'district', 'updatedAt'])
        && request.resource.data.fullName is string && request.resource.data.fullName.size() <= 200
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30
        && request.resource.data.address is string && request.resource.data.address.size() <= 300
        && request.resource.data.district is string && request.resource.data.district.size() <= 100;

      // Admin: ClientManagementScreen crea (addDoc), edita y elimina (lectura ya cubierta arriba).
      allow create, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // productos: catálogo con lectura pública; solo admin escribe
    // (productService.ts y orderService.ts, que descuenta stock, se usan
    // únicamente desde /admin/*).
    // ---------------------------------------------------------------
    match /productos/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // services y projects: contenido del sitio público gestionado desde
    // /admin/servicios y /admin/proyectos. Lectura pública, escritura admin.
    // ---------------------------------------------------------------
    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // pedidos y listOrden: órdenes de venta emitidas por el admin
    // (orderService.ts). No hay flujo de cliente: solo admin.
    // ---------------------------------------------------------------
    match /pedidos/{orderId} {
      allow read, write: if isAdmin();
    }

    match /listOrden/{orderId} {
      allow read, write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // presupuestos y presupuestos_solicitados: HOY NINGÚN CÓDIGO de src/ los
    // usa. Acceso mínimo: la creación está cerrada; el dueño (campo userId) o un
    // admin leen; update/delete solo admin. Ajustar con hasOnly([...]) cuando exista el flujo.
    // ---------------------------------------------------------------
    match /presupuestos/{budgetId} {
      // Creación cerrada hasta que exista el flujo (ningún código de src/ la usa). Al implementarlo,
      // reabrir con hasOnly([...]), validación de tipos y tamaños.
      allow create: if false;
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.get('userId', '') == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // F5.4: solicitud de presupuesto desde /presupuesto. El id del documento es el
    // correlativo GYA-AAAA-XXXX. Creación pública con validación de campos; lectura
    // (también del dueño por userId) y actualización solo admin / dueño; borrar solo admin.
    match /presupuestos_solicitados/{solicitudId} {
      allow create: if solicitudId.matches('^GYA-[0-9]{4}-[0-9]{4,}$')
        && request.resource.data.keys().hasOnly(
             ['number', 'userId', 'fullName', 'dniRuc', 'email', 'phone', 'address', 'district', 'params', 'total', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(
             ['number', 'userId', 'fullName', 'phone', 'params', 'total', 'status', 'createdAt'])
        && request.resource.data.number == solicitudId
        && request.resource.data.status == 'PENDIENTE'
        && request.resource.data.userId is string && request.resource.data.userId.size() <= 128
        && (!isSignedIn() || request.resource.data.userId == request.auth.uid)
        && request.resource.data.fullName is string && request.resource.data.fullName.size() > 0 && request.resource.data.fullName.size() <= 200
        && request.resource.data.get('dniRuc', '') is string && request.resource.data.get('dniRuc', '').size() <= 20
        && request.resource.data.get('email', '') is string && request.resource.data.get('email', '').size() <= 254
        && request.resource.data.phone is string && request.resource.data.phone.size() > 0 && request.resource.data.phone.size() <= 30
        && request.resource.data.get('address', '') is string && request.resource.data.get('address', '').size() <= 300
        && request.resource.data.get('district', '') is string && request.resource.data.get('district', '').size() <= 100
        && request.resource.data.params is map
        && request.resource.data.total is number && request.resource.data.total >= 0 && request.resource.data.total < 10000000
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.get('userId', '') == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Contador atómico del correlativo (contadores/presupuesto-AAAA).
    // Permite inicializar en 1 o incrementar en 1 de forma atómica en la transacción del presupuesto.
    match /contadores/{counterId} {
      allow create: if counterId.matches('^presupuesto-[0-9]{4}$')
        && request.resource.data.keys().hasOnly(['seq'])
        && request.resource.data.seq == 1;
      allow update: if counterId.matches('^presupuesto-[0-9]{4}$')
        && request.resource.data.keys().hasOnly(['seq'])
        && request.resource.data.seq == resource.data.seq + 1;
      allow read: if counterId.matches('^presupuesto-[0-9]{4}$');
      allow delete: if isAdmin();
      // Correlativo de pedidos a proveedor (contadores/pedidos-AAAA): solo admin.
      // Regla aparte (se combina por OR): no altera lo anterior de presupuesto-AAAA.
      allow read, create, update: if counterId.matches('^pedidos-.*') && isAdmin();
    }

    // ---------------------------------------------------------------
    // Datos internos de proveedores: nunca visibles para clientes ni anónimos.
    // ---------------------------------------------------------------
    match /proveedores_productos/{id} {
      allow read, write: if isAdmin();
    }

    match /pedidos_proveedor/{id} {
      allow read, write: if isAdmin();
    }

    // sistemas: los publicados se leen en páginas públicas; los borradores solo admin.
    // Una consulta de lista de un cliente solo pasa si filtra por estado == 'publicado'.
    match /sistemas/{id} {
      allow read: if isAdmin() || resource.data.get('estado', '') == 'publicado';
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Colecciones legales y de contacto (creación exclusiva vía Cloud Functions
    // con Admin SDK; prohibido borrar desde cliente por retención legal de 2 años).
    // El administrador puede leer y actualizar únicamente el estado de atención.
    // ---------------------------------------------------------------
    match /libro_de_reclamaciones/{reclamoId} {
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'adminNotes'])
        && request.resource.data.status in ['RECIBIDO', 'EN_REVISION', 'EN_PROCESO', 'ATENDIDO'];
      allow create, delete: if false;
    }

    match /contact_submissions/{submissionId} {
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'adminNotes'])
        && request.resource.data.status in ['RECIBIDO', 'EN_REVISION', 'EN_PROCESO', 'ATENDIDO'];
      allow create, delete: if false;
    }

    match /rate_limits/{limitId} {
      allow read, write: if false;
    }

    // Cierre por defecto (documentado): todo lo no listado queda denegado.
    // Las coincidencias se combinan con OR, así que esto no anula lo anterior.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
