rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para verificar si el usuario es Admin
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.role == 'admin' || 
         (request.auth.token.email != null && request.auth.token.email.matches('.*admin.*')) ||
         (request.auth.token.email != null && request.auth.token.email.matches('.*@gyacompany[.]com.*')) ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }
    
    // Función auxiliar para verificar si el usuario es el dueño del documento
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Colección de Usuarios y Roles (users)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Colección de Perfiles de Clientes (clientes)
    match /clientes/{clientId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Colección de Productos e Inventario (productos)
    match /productos/{productId} {
      allow read: if true; // Lectura pública para catálogo y cotizador
      allow write: if request.auth != null; // Usuarios autenticados / administradores
    }

    // Colección de Presupuestos (presupuestos)
    match /presupuestos/{budgetId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Colección de Presupuestos Solicitados (presupuestos_solicitados)
    match /presupuestos_solicitados/{solicitudId} {
      allow read, write: if request.auth != null;
    }

    // Colección de Pedidos y Órdenes de Salida (pedidos & listOrden)
    match /pedidos/{orderId} {
      allow read, write: if request.auth != null;
    }

    match /listOrden/{orderId} {
      allow read, write: if request.auth != null;
    }

    // Colección Legal del Libro de Reclamaciones (Aislada a Cloud Functions)
    match /libro_de_reclamaciones/{reclamoId} {
      allow read, write: if false;
    }
  }
}
