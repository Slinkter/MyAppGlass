{
  "main": "index.js",
  "name": "@gya/functions",
  "engines": {
    "node": "22"
  },
  "private": true,
  "scripts": {
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint .",
    "logs": "firebase functions:log",
