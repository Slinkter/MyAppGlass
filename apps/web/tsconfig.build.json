{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": null,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@features/*": [
        "./src/features/*"
      ],
      "@shared/*": [
        "./src/shared/*"
      ],
      "@widgets/*": [
        "./src/widgets/*"
      ],
      "@screens/*": [
        "./src/screens/*"
      ]
    }
  }
}
