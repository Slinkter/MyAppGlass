{
	"info": {
		"_postman_id": "gya-full-audit-v2",
		"name": "GYA Company - Auditoría de Página (SEO & Seguridad)",
		"description": "Valida la página del Libro de Reclamaciones (SEO, reCAPTCHA v3 y cabeceras de seguridad HTTP). No envía datos a ningún backend.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "siteUrl",
			"value": "https://gya-app-4c8a9.web.app",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Validación de Página (SEO, Seguridad & Health)",
			"item": [
				{
					"name": "Verificar SEO y Seguridad - Libro de Reclamaciones",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Estado exitoso (200)', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Contenido es HTML', function () {",
									"    pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html');",
									"});",
									"",
									"pm.test('Título SEO presente', function () {",
									"    pm.expect(pm.response.text()).to.include('<title>Libro de Reclamaciones');",
									"});",
									"",
									"pm.test('JSON-LD de Autoridad presente', function () {",
									"    pm.expect(pm.response.text()).to.include('application/ld+json');",
									"});",
									"",
									"pm.test('Script de Google reCAPTCHA v3 cargado', function () {",
									"    pm.expect(pm.response.text()).to.include('google.com/recaptcha/api.js');",
									"});",
									"",
									"pm.test('Cabeceras de seguridad HTTP presentes', function () {",
									"    pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff');",
									"    pm.expect(pm.response.headers.get('Content-Security-Policy')).to.include('us-central1-gya-app-4c8a9.cloudfunctions.net');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{siteUrl}}/libro-de-reclamacion",
							"host": [
								"{{siteUrl}}"
							],
							"path": [
								"libro-de-reclamacion"
							]
						},
						"description": "Verifica que la página sea accesible y contenga los metadatos SEO, script de reCAPTCHA v3 y cabeceras HTTP de seguridad."
					},
					"response": []
				}
			],
			"description": "Pruebas para la interfaz web."
		}
	]
}
