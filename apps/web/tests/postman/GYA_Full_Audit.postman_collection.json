{
	"info": {
		"_postman_id": "gya-full-audit-v2",
		"name": "GYA Company - Auditoría de Página (SEO)",
		"description": "Valida la página del Libro de Reclamaciones (SEO y disponibilidad). No envía datos a ningún backend.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "siteUrl",
			"value": "https://gyacompany.com",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Validación de Página (SEO & Health)",
			"item": [
				{
					"name": "Verificar SEO - Libro de Reclamaciones",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Estado exitoso (200)', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Contenido es HTML', function () {",
									"    pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html');",
									"});",
									"",
									"pm.test('Título SEO presente', function () {",
									"    pm.expect(pm.response.text()).to.include('<title>Libro de Reclamaciones');",
									"});",
									"",
									"pm.test('JSON-LD de Autoridad presente', function () {",
									"    pm.expect(pm.response.text()).to.include('application/ld+json');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{siteUrl}}/libro-de-reclamacion",
							"host": [
								"{{siteUrl}}"
							],
							"path": [
								"libro-de-reclamacion"
							]
						},
						"description": "Verifica que la página sea accesible y contenga los metadatos SEO que optimizamos."
					},
					"response": []
				}
			],
			"description": "Pruebas para la interfaz web."
		}
	]
}
