rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Admin en Storage: requiere custom claim role=admin (sin excepción por dominio).
    // NO se consulta users/{uid} de Firestore (firestore.get): esa vía exige
    // conceder permisos IAM a la cuenta de servicio de Storage al desplegar. Si se
    // necesita, añadirla en una decisión aparte.
    function isAdmin() {
      return request.auth != null && request.auth.token.get('role', '') == 'admin';
    }

    // Imágenes y assets estáticos del frontend: lectura pública, sin escritura.
    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Imágenes y modelos 3D de productos: lectura pública; solo admin escribe,
    // con tope de 25 MB y tipos de contenido de imagen/modelo 3D.
    // (El admin de servicios y proyectos sube a /services y /projects, ver abajo.)
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource != null
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|model/.*|application/octet-stream');
      allow delete: if isAdmin();
    }

    // Material interno de proveedores (fichas, planos, fotos): solo admin.
    match /proveedores/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // Portadas y álbumes de servicios, proyectos y blog (storageService.ts):
    // lectura pública; solo admin escribe imágenes de hasta 10 MB.
    match /{collection}/{entityId}/{allPaths=**} {
      allow read: if collection in ['services', 'projects', 'blog'];
      allow write: if collection in ['services', 'projects', 'blog']
        && isAdmin()
        && request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if collection in ['services', 'projects', 'blog'] && isAdmin();
    }

    // Denegar todo lo demás por defecto.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
